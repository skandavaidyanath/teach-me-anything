{
  "name": "teach-me-anything",
  "private": true,
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tma/web --filter @tma/harness run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @tma/web dev",
    "dev:harness": "pnpm --filter @tma/harness dev"
  }
}
